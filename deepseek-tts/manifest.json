{
  "schema": 1,
  "name": "@razuresoft/0kay-deepseek-tts",
  "version": "0.1.0",
  "description": "DeepSeek web TTS as a local voice backend for LIFE / the WebUI (wraps deepseek-tts-api).",
  "repository": "https://github.com/RazureSOFT/0KAY",
  "requires": ["core"],
  "install": [],
  "start": ["node", "src/server.mjs"],
  "ports": { "http": 8792 },
  "permissions": {
    "api": { "requires": ["GET /api/settings/life", "POST /api/settings/life"] },
    "egress": ["chat.deepseek.com", "*.deepseek.com"]
  }
}
