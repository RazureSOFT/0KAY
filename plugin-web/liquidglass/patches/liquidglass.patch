        "css": "/* Liquid Glass (Apple-style) component treatment for the 0KAY WebUI. */\n\n/* ---------- typography, shape, motion, elevation ---------- */\nhtml:root {\n  color-scheme: light;\n  --font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, \"Segoe UI Emoji\", sans-serif;\n  --font-size-base: 14px;\n  --font-size-lg: 20px;\n  --font-size-xl: 28px;\n  --font-size-xxl: 40px;\n  --radius-xs: 6px;\n  --radius-sm: 8px;\n  --radius-md: 10px;\n  --radius-lg: 14px;\n  --radius-xl: 20px;\n  --shadow-1: 0 1px 2px rgba(0,0,0,.05), 0 0 .5px rgba(0,0,0,.07);\n  --shadow-2: 0 3px 10px rgba(0,0,0,.07), 0 0 .5px rgba(0,0,0,.09);\n  --shadow-3: 0 6px 18px rgba(0,0,0,.09), 0 0 .5px rgba(0,0,0,.10);\n  --shadow-4: 0 10px 28px rgba(0,0,0,.11), 0 0 .5px rgba(0,0,0,.12);\n  --shadow-8: 0 18px 44px rgba(0,0,0,.14), 0 0 .5px rgba(0,0,0,.14);\n  --shadow-16: 0 30px 64px rgba(0,0,0,.18), 0 0 .5px rgba(0,0,0,.16);\n  --ease-standard: cubic-bezier(.32, .72, 0, 1);\n  --ease-emphasized: cubic-bezier(.32, .72, 0, 1);\n  --ease-emphasized-decel: cubic-bezier(.16, 1, .3, 1);\n  --ease-emphasized-accel: cubic-bezier(.7, 0, .84, 0);\n  --ease-spring: cubic-bezier(.32, .72, 0, 1);\n  --duration-short: 120ms;\n  --duration-medium: 200ms;\n  --duration-long: 320ms;\n  --transition-fast: 120ms var(--ease-standard);\n  --transition-normal: 180ms var(--ease-standard);\n  --transition-slow: 240ms var(--ease-standard);\n}\nhtml:root[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --shadow-1: 0 0 .5px rgba(0,0,0,.65);\n  --shadow-2: 0 3px 10px rgba(0,0,0,.40), 0 0 .5px rgba(0,0,0,.65);\n  --shadow-3: 0 6px 18px rgba(0,0,0,.45), 0 0 .5px rgba(0,0,0,.68);\n  --shadow-4: 0 10px 28px rgba(0,0,0,.50), 0 0 .5px rgba(0,0,0,.70);\n  --shadow-8: 0 18px 44px rgba(0,0,0,.55), 0 0 .5px rgba(0,0,0,.72);\n  --shadow-16: 0 30px 64px rgba(0,0,0,.60), 0 0 .5px rgba(0,0,0,.75);\n}\n\n/* ---------- liquid glass component layer ----------------------------------\n   Same !important discipline as the fluent patch: host rules are scoped\n   #app .page .x[data-v-...] selectors no theme selector can out-specify.\n   Layering model: a fixed mesh wash lives on html:root; app-main is one big\n   translucent slab over it; chrome panels (header, rail, composer, settings\n   drawer, select menus) add backdrop blur and carry the engine's real\n   refraction; cards stay filter-free so the page keeps one compositing pass. */\n\n/* refracted backdrop: soft color wash behind every glass surface */\nhtml:root {\n  background-image:\n    radial-gradient(58% 46% at 4% 0%, var(--lg-wash-1), transparent 70%),\n    radial-gradient(50% 44% at 98% 4%, var(--lg-wash-2), transparent 72%),\n    radial-gradient(62% 52% at 86% 100%, var(--lg-wash-3), transparent 68%),\n    radial-gradient(46% 42% at 22% 96%, var(--lg-wash-4), transparent 70%);\n  background-color: var(--md-surface);\n  background-attachment: fixed;\n}\nbody, #app, #app .app-shell { background: transparent !important; }\n\n/* page roots let the slab glass show through */\n#app :is(.chat-page, .settings-page, .plugins-page, .usage-page, .workspace, .route-view) { background: transparent !important; }\n\n/* typography ------------------------------------------------------------ */\n#app .page-header h1, #app .pp-hero h1 { font-size: clamp(24px, 2.4vw, 30px) !important; font-weight: 700 !important; letter-spacing: -0.02em !important; }\n#app .content-card h2, #app .ls-card h3 { font-weight: 600 !important; letter-spacing: -0.01em !important; }\n#app :is(.pp-eyebrow, .eyebrow, .ls-eyebrow, .inbox-eyebrow, .mp-eyebrow) { font-family: var(--font-family) !important; font-size: 11px !important; font-weight: 500 !important; letter-spacing: normal !important; text-transform: none !important; color: var(--md-on-surface-variant) !important; }\n#app .subtitle, #app .card-desc, #app .plugin-meta dd { font-weight: 400 !important; }\n#app .plugin-titles h2 { font-size: 16px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; }\n#app .plugin-meta dt { font-weight: 600 !important; letter-spacing: normal !important; text-transform: none !important; }\n#app .plugin-switch, #app .toggle-label, #app .switch-text, #app .plugin-switch-label { font-weight: 400 !important; }\n#app .conversation-header h2 { font-size: 16px !important; font-weight: 600 !important; }\n\n/* banners + wizard steps --------------------------------------------------- */\n#app :is(.error-banner, .notice-banner, .us-apply-banner, .banner, .step) { border-radius: 12px !important; }\n\n/* app chrome: glass header + rail over the wash --------------------------- */\n#app .app-header {\n  background: var(--lg-chrome) !important;\n  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;\n  backdrop-filter: blur(28px) saturate(190%) !important;\n  border-bottom: none !important;\n  box-shadow: 0 1px 0 var(--lg-hi), 0 12px 32px rgba(0,0,0,.05) !important;\n}\n#app .brand-mark, .auth-mark { border-radius: 999px !important; letter-spacing: normal !important; -webkit-background-clip: border-box !important; background-clip: border-box !important; }\n#app .page-title { font-weight: 600 !important; letter-spacing: -0.01em !important; }\n#app .icon-btn { border-radius: 999px !important; background: var(--md-surface-container-high) !important; }\n#app .icon-btn:hover { background: var(--md-surface-container-highest) !important; }\n#app .nav-rail {\n  background: var(--lg-chrome) !important;\n  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;\n  backdrop-filter: blur(28px) saturate(190%) !important;\n  border-right: none !important;\n  box-shadow: 1px 0 0 var(--lg-hi), 14px 0 34px rgba(0,0,0,.04) !important;\n  gap: 4px !important;\n}\n#app .nav-rail .nav-item { border-radius: 12px !important; font-weight: 500 !important; letter-spacing: normal !important; }\n#app .nav-rail .nav-item::before { border-radius: 12px !important; width: 64px !important; height: 44px !important; top: 50% !important; left: 50% !important; right: auto !important; bottom: auto !important; transform: translate(-50%, -50%) !important; background: color-mix(in srgb, var(--md-on-surface) 8%, transparent) !important; }\n#app .nav-rail .nav-item.active::before { transform: translate(-50%, -50%) !important; background: color-mix(in srgb, var(--md-primary) 16%, transparent) !important; }\n#app .nav-rail .nav-item.active { color: var(--md-primary) !important; font-weight: 600 !important; }\n#app .nav-rail .nav-item.active .nav-icon, #app .nav-rail .nav-item:hover .nav-icon { transform: none !important; color: inherit !important; }\n#app .app-main {\n  border-radius: 26px !important;\n  background: var(--lg-slab) !important;\n  -webkit-backdrop-filter: blur(40px) saturate(185%) !important;\n  backdrop-filter: blur(40px) saturate(185%) !important;\n  border: 1px solid var(--lg-hairline) !important;\n  box-shadow: 0 24px 64px rgba(0,0,0,.12), inset 0 0 0 .5px var(--lg-hi) !important;\n}\n\n/* sessions + conversation chrome ------------------------------------------- */\n#app .sessions { background: var(--lg-panel) !important; border-right: 1px solid var(--lg-hairline) !important; }\n#app .session-item { border-radius: 12px !important; }\n#app .session-item.selected { background: color-mix(in srgb, var(--md-primary) 16%, transparent) !important; color: var(--md-primary) !important; }\n#app .filters { background: color-mix(in srgb, var(--md-on-surface) 7%, transparent) !important; border: none !important; border-radius: 999px !important; padding: 4px !important; }\n#app .filters button { border-radius: 999px !important; }\n#app .filters button.chosen { background: var(--md-surface-container-lowest) !important; color: var(--md-primary) !important; box-shadow: var(--shadow-1) !important; }\n#app .conversation-header { border-bottom: 1px solid var(--lg-hairline) !important; }\n\n/* settings drawer: floating glass card (engine refraction target) ---------- */\n#app .settings-page .settings-nav { background: var(--lg-menu) !important; -webkit-backdrop-filter: blur(28px) saturate(190%) !important; backdrop-filter: blur(28px) saturate(190%) !important; border: 1px solid var(--lg-hairline) !important; border-radius: 24px !important; box-shadow: 0 18px 44px rgba(0,0,0,.12), inset 0 0 0 .5px var(--lg-hi) !important; padding: 8px !important; gap: 2px !important; }\n#app .settings-page .nav-item::before { display: none !important; }\n#app .settings-page .nav-item { min-height: 40px !important; border-radius: 12px !important; padding: 0 14px !important; gap: 12px !important; font: 500 14px/1.25 var(--font-family) !important; color: var(--md-on-surface) !important; }\n#app .settings-page .nav-item.active { background: color-mix(in srgb, var(--md-primary) 16%, transparent) !important; color: var(--md-primary) !important; font-weight: 600 !important; }\n#app .settings-page .nav-item.active .nav-indicator { display: none !important; }\n#app .settings-page .nav-item.active .nav-icon { transform: none !important; color: inherit !important; }\n#app .settings-page .nav-item:hover:not(.active) { background: color-mix(in srgb, var(--md-on-surface) 8%, transparent) !important; color: var(--md-on-surface) !important; }\n#app .settings-page .nav-item:hover:not(.active) .nav-indicator { opacity: 0 !important; }\n#app .settings-page .provider-list-item.selected { background: var(--md-secondary-container) !important; border-color: color-mix(in srgb, var(--md-primary) 40%, transparent) !important; }\n\n/* cards: one 24px translucent slab with a hairline and inner light --------- */\n#app :is(.card, .plugin-card, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .content-card, .pp-card, .ls-card, .model-card, .donut-card, .total-card, .host-panel, .character-profile, .pp-stat, .task-item, .lang-card, .pv-card, .pin-card) { border-radius: 24px !important; background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; box-shadow: 0 2px 8px rgba(0,0,0,.05), inset 0 0 0 .5px var(--lg-hi) !important; }\n#app .settings-page .content-card { background-image: none !important; }\n#app :is(.content-card, .content-card.danger)::before { display: none !important; }\n#app .pp-stat { padding: 16px 18px !important; color: var(--md-on-surface) !important; }\n#app .pp-stat b { font-size: 28px !important; font-weight: 700 !important; letter-spacing: -0.02em !important; color: var(--md-on-surface) !important; }\n#app .pp-stat span { font-weight: 500 !important; letter-spacing: normal !important; color: var(--md-on-surface-variant) !important; }\n#app .plugins-page .plugin-card { border-radius: 24px !important; padding: 20px !important; }\n#app .plugins-page .plugin-card:hover { transform: none !important; border-color: color-mix(in srgb, var(--md-on-surface) 14%, transparent) !important; box-shadow: 0 8px 24px rgba(0,0,0,.08), inset 0 0 0 .5px var(--lg-hi) !important; }\n#app .plugins-page .plugin-card.healthy::before { display: none !important; }\n#app :is(.plugin-icon, .empty-icon, .stat-ic) { border: none !important; }\n#app .plugin-icon { width: 44px !important; height: 44px !important; border-radius: 12px !important; }\n#app :is(.empty-icon, .stat-ic) { border-radius: 16px !important; }\n#app .usage-page :is(.stat-ic, .mini-ic) { border: none !important; background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; }\n#app .card :is(.card, .content-card, .tasks-card, .settings-card, .stat-card, .memory-card, .plugin-card, .pp-card, .mini, .panel, .host-panel) { border-color: transparent !important; background: color-mix(in srgb, var(--md-on-surface) 6%, transparent) !important; box-shadow: none !important; }\n\n/* colorful stat tiles: Apple system tints ---------------------------------- */\n#app :is(.stat-card, .stats > article):nth-child(3n+1) { background: rgba(0,122,255,.16) !important; color: #004999 !important; }\n#app :is(.stat-card, .stats > article):nth-child(3n+2) { background: rgba(255,159,10,.20) !important; color: #7A4400 !important; }\n#app :is(.stat-card, .stats > article):nth-child(3n) { background: rgba(52,199,89,.18) !important; color: #0B6B26 !important; }\nhtml:root[data-theme=\"dark\"] #app :is(.stat-card, .stats > article):nth-child(3n+1) { background: rgba(10,132,255,.28) !important; color: #8FC2FF !important; }\nhtml:root[data-theme=\"dark\"] #app :is(.stat-card, .stats > article):nth-child(3n+2) { background: rgba(255,159,10,.24) !important; color: #FFC46B !important; }\nhtml:root[data-theme=\"dark\"] #app :is(.stat-card, .stats > article):nth-child(3n) { background: rgba(48,209,88,.24) !important; color: #7BE396 !important; }\n\n/* chips and badges: capsule labels ---------------------------------------- */\n#app :is(.status-chip, .source-badge, .cap-chip, .badge, .ver-badge, .patch-badge, .pd-chip, .us-chip, .us-chip-tag, .pp-badge, .pp-chip, .chip) { border-radius: 999px !important; height: auto !important; padding: 3px 10px !important; font-size: 12px !important; font-weight: 500 !important; border-color: transparent !important; }\n#app .chip.active { background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; border-color: transparent !important; }\n#app .source-badge.rt { background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; }\n\n/* buttons: capsules, accent fill for primary actions ----------------------- */\n#app button { border-radius: 999px !important; font-weight: 500 !important; letter-spacing: normal !important; }\n#app button:active:not(:disabled) { transform: none !important; }\n#app .btn { height: auto !important; min-height: 34px !important; padding: 7px 18px !important; font-size: 14px !important; font-weight: 500 !important; border-radius: 999px !important; border: 1px solid transparent !important; background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; box-shadow: none !important; transition: background-color 120ms var(--ease-standard), border-color 120ms var(--ease-standard), color 120ms var(--ease-standard) !important; }\n#app .btn:hover:not(:disabled) { background: var(--md-surface-container-highest) !important; transform: none !important; box-shadow: none !important; }\n#app .btn:disabled { opacity: .45 !important; }\n#app :is(.btn-primary, button[type=submit]) { background: var(--md-primary) !important; color: var(--md-on-primary) !important; border-color: transparent !important; box-shadow: 0 1px 3px rgba(0,0,0,.18) !important; }\n#app :is(.btn-primary, button[type=submit]):hover:not(:disabled) { background: var(--brand-hover) !important; }\n#app :is(.btn-tonal, .btn-secondary) { background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; border-color: transparent !important; }\n#app .btn-danger, #app .context-btn.danger { background: transparent !important; color: var(--md-error) !important; border-color: transparent !important; }\n#app .btn-danger:hover:not(:disabled), #app .context-btn.danger:hover:not(:disabled) { background: color-mix(in srgb, var(--md-error) 10%, transparent) !important; }\n#app .btn-ghost { background: transparent !important; border-color: transparent !important; color: var(--md-on-surface) !important; }\n#app .btn-ghost:hover:not(:disabled) { background: var(--md-surface-container-high) !important; }\n#app :is(.icon-btn, .context-btn, .link-btn, .attach-btn, .status-fab) { border-radius: 999px !important; }\n#app :is(.la-btn, .la-btn.la-deny) { border-radius: 999px !important; }\n#app .la-btn.la-allow { background: var(--md-primary) !important; color: var(--md-on-primary) !important; border-color: transparent !important; }\n\n/* fields: capsule inputs, 18px textareas ----------------------------------- */\n#app :is(input.input, textarea.input, .field input, .field textarea, .file-input) { min-height: 34px !important; padding: 7px 14px !important; font-size: 14px !important; border-radius: 999px !important; border: 1px solid transparent !important; background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; transition: background-color 120ms var(--ease-standard), box-shadow 120ms var(--ease-standard) !important; }\n#app textarea.input, #app .field textarea { border-radius: 18px !important; }\n#app :is(input.input, textarea.input, .field input, .field textarea, .file-input):focus { border-color: transparent !important; background: var(--md-surface-container-lowest) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-primary) 32%, transparent) !important; outline: none !important; }\n#app select:not([multiple]) { min-height: 34px !important; padding: 0 32px 0 14px !important; font-size: 14px !important; border: 1px solid transparent !important; border-radius: 999px !important; background-color: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; }\n#app select:not([multiple]):hover { background-color: var(--md-surface-container-highest) !important; }\n#app select:not([multiple]):focus { border-color: transparent !important; background-color: var(--md-surface-container-lowest) !important; box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-primary) 32%, transparent) !important; }\n\n/* combo box: capsule trigger + floating glass menu (engine target) --------- */\n#app .app-select-trigger { min-height: 34px !important; border-radius: 999px !important; font-size: 14px !important; font-weight: 500 !important; padding: 0 8px 0 14px !important; gap: 8px !important; background-color: var(--md-surface-container-high) !important; border: 1px solid transparent !important; color: var(--md-on-surface) !important; }\n#app .app-select-trigger:hover:not(:disabled) { background-color: var(--md-surface-container-highest) !important; }\n#app .app-select-trigger[aria-