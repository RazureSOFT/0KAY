{
  "id": "fluentui-theme",
  "name": "Fluent Design theme",
  "version": "0.1.0",
  "plugin": "fluentui",
  "enabled": true,
  "patches": [
    {
      "target": "theme",
      "op": "insert",
      "id": "fluentui",
      "item": {
        "id": "fluentui",
        "order": 10,
        "tokens": {
          "light": {
            "--md-primary": "#005FB8",
            "--md-on-primary": "#FFFFFF",
            "--md-primary-container": "#CCE4F7",
            "--md-on-primary-container": "#04365B",
            "--md-primary-fixed": "#CCE4F7",
            "--md-secondary": "#5D5A58",
            "--md-on-secondary": "#FFFFFF",
            "--md-secondary-container": "#E5E5E5",
            "--md-on-secondary-container": "#1A1A1A",
            "--md-tertiary": "#0067C0",
            "--md-on-tertiary": "#FFFFFF",
            "--md-tertiary-container": "#D6EBFF",
            "--md-on-tertiary-container": "#043B5F",
            "--md-error": "#C42B1C",
            "--md-on-error": "#FFFFFF",
            "--md-error-container": "#FDE7E9",
            "--md-success": "#0F7B0F",
            "--md-success-container": "#DFF6DD",
            "--md-warning": "#9D5D00",
            "--md-surface": "#F3F3F3",
            "--md-surface-dim": "#E5E5E5",
            "--md-surface-bright": "#F9F9F9",
            "--md-surface-container-lowest": "#FFFFFF",
            "--md-surface-container-low": "#FBFBFB",
            "--md-surface-container": "#F3F3F3",
            "--md-surface-container-high": "#EAEAEA",
            "--md-surface-container-highest": "#E0E0E0",
            "--md-on-surface": "#1A1A1A",
            "--md-on-surface-variant": "#616161",
            "--md-outline": "#8A8A8A",
            "--md-outline-variant": "#E0E0E0",
            "--md-inverse-surface": "#2B2B2B",
            "--md-inverse-on-surface": "#F5F5F5",
            "--md-inverse-primary": "#4CC2FF",
            "--md-scrim": "rgba(0,0,0,.3)",
            "--brand-hover": "#1A6FC4",
            "--brand-active": "#004C94"
          },
          "dark": {
            "--md-primary": "#4CC2FF",
            "--md-on-primary": "#000000",
            "--md-primary-container": "#00619E",
            "--md-on-primary-container": "#CCE4F7",
            "--md-primary-fixed": "#00619E",
            "--md-secondary": "#C5C5C5",
            "--md-on-secondary": "#1A1A1A",
            "--md-secondary-container": "#3A3A3A",
            "--md-on-secondary-container": "#EAEAEA",
            "--md-tertiary": "#60CDFF",
            "--md-on-tertiary": "#00395E",
            "--md-tertiary-container": "#00456B",
            "--md-on-tertiary-container": "#CCE4F7",
            "--md-error": "#FF99A4",
            "--md-on-error": "#420000",
            "--md-error-container": "#4A100E",
            "--md-success": "#6CCB5F",
            "--md-success-container": "#0F3B0F",
            "--md-warning": "#FCE100",
            "--md-surface": "#202020",
            "--md-surface-dim": "#1A1A1A",
            "--md-surface-bright": "#272727",
            "--md-surface-container-lowest": "#272727",
            "--md-surface-container-low": "#242424",
            "--md-surface-container": "#202020",
            "--md-surface-container-high": "#2B2B2B",
            "--md-surface-container-highest": "#323232",
            "--md-on-surface": "#FFFFFF",
            "--md-on-surface-variant": "#C5C5C5",
            "--md-outline": "#B0B0B0",
            "--md-outline-variant": "#3D3D3D",
            "--md-inverse-surface": "#F3F3F3",
            "--md-inverse-on-surface": "#1A1A1A",
            "--md-inverse-primary": "#005FB8",
            "--md-scrim": "rgba(0,0,0,.6)",
            "--brand-hover": "#60CDFF",
            "--brand-active": "#76D0FF"
          }
        },
        "css": "/* Fluent Design (Win11) component treatment for the 0KAY WebUI. */\n\n/* ---------- typography, shape, motion, elevation ---------- */\nhtml:root {\n  color-scheme: light;\n  --font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, \"Segoe UI Emoji\", sans-serif;\n  --font-size-base: 14px;\n  --font-size-lg: 20px;\n  --font-size-xl: 28px;\n  --font-size-xxl: 40px;\n  --radius-xs: 4px;\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 8px;\n  --radius-xl: 8px;\n  --shadow-1: 0 1px 2px rgba(0,0,0,.06), 0 0 1px rgba(0,0,0,.10);\n  --shadow-2: 0 2px 4px rgba(0,0,0,.08), 0 0 1px rgba(0,0,0,.12);\n  --shadow-3: 0 4px 8px rgba(0,0,0,.10), 0 0 2px rgba(0,0,0,.12);\n  --shadow-4: 0 8px 16px rgba(0,0,0,.14), 0 0 2px rgba(0,0,0,.14);\n  --shadow-8: 0 16px 32px rgba(0,0,0,.18), 0 0 4px rgba(0,0,0,.16);\n  --shadow-16: 0 32px 64px rgba(0,0,0,.24), 0 0 6px rgba(0,0,0,.16);\n  --ease-standard: cubic-bezier(.8, 0, .2, 1);\n  --ease-emphasized: cubic-bezier(.8, 0, .2, 1);\n  --ease-emphasized-decel: cubic-bezier(0, 0, 0, 1);\n  --ease-emphasized-accel: cubic-bezier(.7, 0, 1, .5);\n  --ease-spring: cubic-bezier(.2, 0, 0, 1);\n  --duration-short: 50ms;\n  --duration-medium: 150ms;\n  --duration-long: 250ms;\n  --transition-fast: 100ms var(--ease-standard);\n  --transition-normal: 150ms var(--ease-standard);\n  --transition-slow: 250ms var(--ease-standard);\n}\nhtml:root:where([data-theme=\"dark\"]) {\n  color-scheme: dark;\n  --shadow-1: 0 0 1px rgba(0,0,0,.7);\n  --shadow-2: 0 0 1px rgba(0,0,0,.7), 0 2px 6px rgba(0,0,0,.40);\n  --shadow-3: 0 0 1px rgba(0,0,0,.7), 0 4px 12px rgba(0,0,0,.45);\n  --shadow-4: 0 0 1px rgba(0,0,0,.7), 0 8px 24px rgba(0,0,0,.50);\n  --shadow-8: 0 0 1px rgba(0,0,0,.7), 0 16px 40px rgba(0,0,0,.55);\n  --shadow-16: 0 0 1px rgba(0,0,0,.7), 0 32px 64px rgba(0,0,0,.60);\n}\n\n/* ---------- app chrome ---------- */\n#app .nav-rail { background: var(--md-surface-container); }\n#app .nav-item { border-radius: 4px; }\n#app .nav-item::before { border-radius: 4px; }\n#app .nav-item.active::before { border-radius: 4px; background: var(--md-secondary-container); }\n#app .sessions { background: var(--md-surface-container); }\n#app .session-item { border-radius: 4px; }\n#app .session-item.selected { border-radius: 4px; background: var(--md-secondary-container); color: var(--md-on-secondary-container); }\n#app .filters button { border-radius: 4px; }\n#app .message.request { background: var(--md-surface-container-high); border: 1px solid var(--md-outline-variant); border-radius: 8px; }\n#app .composer { background: var(--md-surface-container-lowest); border: 1px solid var(--md-outline-variant); border-radius: 8px; box-shadow: var(--shadow-1); }\n#app .composer textarea { border-radius: 8px 8px 0 0; }\n#app .composer footer button[type=submit] { border-radius: 4px; }\n#app .composer footer button[type=submit]:active { transform: none; }\n\n/* ---------- buttons ---------- */\n#app button { border-radius: 4px; font-weight: 400; letter-spacing: normal; }\n#app button:active:not(:disabled) { transform: none; }\n#app .btn { min-height: 36px; padding: 7px 16px; border: 1px solid transparent; transition: background-color 100ms var(--ease-standard), border-color 100ms var(--ease-standard), box-shadow 100ms var(--ease-standard); }\n#app .btn:active:not(:disabled) { transform: none; }\n#app :is(.btn-primary, button[type=submit]) { border-radius: 4px; }\n#app .btn-primary:hover:not(:disabled) { box-shadow: none; filter: brightness(1.08); }\n#app :is(.btn-tonal, .btn-secondary) { background: var(--md-surface-container-lowest); border-color: var(--md-outline); color: var(--md-on-surface); }\n#app :is(.btn-tonal, .btn-secondary):hover:not(:disabled) { background: var(--md-surface-container-high); box-shadow: none; }\n#app .btn-ghost { background: transparent; border-color: transparent; }\n#app .btn-ghost:hover:not(:disabled) { background: var(--md-surface-container-high); }\n\n/* ---------- fields ---------- */\n#app .input { min-height: 36px; padding: 7px 11px; font-size: 14px; border-radius: 4px; border-color: var(--md-outline); background: var(--md-surface-container-lowest); }\n#app .input:focus { border-color: var(--md-primary); box-shadow: 0 0 0 1px var(--md-primary), inset 0 0 0 1px var(--md-surface-container-lowest); }\n#app select:not([multiple]) { min-height: 36px; padding: 0 34px 0 11px; font-size: 14px; border: 1px solid var(--md-outline); border-radius: 4px; background-color: var(--md-surface-container-lowest); }\n#app select:not([multiple]):hover { background-color: var(--md-surface-container-high); }\n#app select:not([multiple]):focus { border-color: var(--md-primary); background-color: var(--md-surface-container-lowest); box-shadow: 0 0 0 1px var(--md-primary); }\n#app select.tiny, #app select.field.tiny { border-radius: 4px; }\n\n/* ---------- surfaces ---------- */\n#app :is(.card, .plugin-card, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .stats > article) { background: var(--md-surface-container-lowest); color: var(--md-on-surface); border: 1px solid var(--md-outline-variant); border-radius: 8px; box-shadow: var(--shadow-1); }\n#app :is(.host-panel, .character-profile) { background: var(--md-surface-container-lowest); border: 1px solid var(--md-outline-variant); border-radius: 8px; }\n#app :is(.agent-modal, .directory-dialog, .modal-content, [role=dialog]) { border: 1px solid var(--md-outline-variant); border-radius: 8px; }\n#app .chip { border-radius: 4px; border-color: var(--md-outline-variant); }\n#app .chip.active { background: var(--md-secondary-container); color: var(--md-on-secondary-container); border-color: transparent; }\n\n/* ---------- Fluent focus rectangle ---------- */\n#app :is(button, a, input, select, textarea, summary):focus-visible { outline: 2px solid var(--md-primary); outline-offset: 1px; }\n"
      }
    }
  ]
}
