        "css": "/* Fluent Design (Win11) component treatment for the 0KAY WebUI. */\n\n/* ---------- typography, shape, motion, elevation ---------- */\nhtml:root {\n  color-scheme: light;\n  --font-family: \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, \"Segoe UI Emoji\", sans-serif;\n  --font-size-base: 14px;\n  --font-size-lg: 20px;\n  --font-size-xl: 28px;\n  --font-size-xxl: 40px;\n  --radius-xs: 4px;\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 8px;\n  --radius-xl: 8px;\n  --shadow-1: 0 1px 2px rgba(0,0,0,.06), 0 0 1px rgba(0,0,0,.10);\n  --shadow-2: 0 2px 4px rgba(0,0,0,.08), 0 0 1px rgba(0,0,0,.12);\n  --shadow-3: 0 4px 8px rgba(0,0,0,.10), 0 0 2px rgba(0,0,0,.12);\n  --shadow-4: 0 8px 16px rgba(0,0,0,.14), 0 0 2px rgba(0,0,0,.14);\n  --shadow-8: 0 16px 32px rgba(0,0,0,.18), 0 0 4px rgba(0,0,0,.16);\n  --shadow-16: 0 32px 64px rgba(0,0,0,.24), 0 0 6px rgba(0,0,0,.16);\n  --ease-standard: cubic-bezier(.8, 0, .2, 1);\n  --ease-emphasized: cubic-bezier(.8, 0, .2, 1);\n  --ease-emphasized-decel: cubic-bezier(.1, .9, .2, 1);\n  --ease-emphasized-accel: cubic-bezier(.7, 0, .8, 0);\n  --ease-spring: cubic-bezier(.8, 0, .2, 1);\n  --duration-short: 100ms;\n  --duration-medium: 200ms;\n  --duration-long: 300ms;\n  --transition-fast: 100ms var(--ease-standard);\n  --transition-normal: 150ms var(--ease-standard);\n  --transition-slow: 200ms var(--ease-standard);\n}\nhtml:root[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --shadow-1: 0 0 1px rgba(0,0,0,.7);\n  --shadow-2: 0 0 1px rgba(0,0,0,.7), 0 2px 6px rgba(0,0,0,.40);\n  --shadow-3: 0 0 1px rgba(0,0,0,.7), 0 4px 12px rgba(0,0,0,.45);\n  --shadow-4: 0 0 1px rgba(0,0,0,.7), 0 8px 24px rgba(0,0,0,.50);\n  --shadow-8: 0 0 1px rgba(0,0,0,.7), 0 16px 40px rgba(0,0,0,.55);\n  --shadow-16: 0 0 1px rgba(0,0,0,.7), 0 32px 64px rgba(0,0,0,.60);\n}\n\n/* ---------- Fluent component layer ---------------------------------------\n   Every rule here carries !important on purpose: the host styles live in\n   scoped #app .page .x[data-v-...] rules whose specificity no theme selector\n   can beat, and a theme patch is the top layer by definition. Among these\n   rules specificity and document order still apply, so variants come after\n   their base selectors. */\n\n/* typography ------------------------------------------------------------ */\n#app .page-header h1, #app .pp-hero h1 { font-size: clamp(24px, 2.4vw, 30px) !important; font-weight: 600 !important; letter-spacing: normal !important; }\n#app .content-card h2, #app .ls-card h3 { font-weight: 600 !important; letter-spacing: normal !important; }\n#app :is(.pp-eyebrow, .eyebrow, .ls-eyebrow, .inbox-eyebrow, .mp-eyebrow) { font-family: var(--font-family) !important; font-size: 11px !important; font-weight: 400 !important; letter-spacing: normal !important; text-transform: none !important; color: var(--md-on-surface-variant) !important; }\n#app .subtitle, #app .card-desc, #app .plugin-meta dd { font-weight: 400 !important; }\n#app .plugin-titles h2 { font-size: 16px !important; font-weight: 600 !important; letter-spacing: normal !important; }\n#app .plugin-meta dt { font-weight: 600 !important; letter-spacing: normal !important; text-transform: none !important; }\n#app .plugin-switch, #app .toggle-label, #app .switch-text, #app .plugin-switch-label { font-weight: 400 !important; }\n#app .conversation-header h2 { font-size: 16px !important; font-weight: 600 !important; }\n\n/* page surfaces: flat Win11 layers, no expressive washes ---------------- */\n#app :is(.settings-page, .plugins-page, .usage-page) { background: var(--md-surface) !important; }\n#app :is(.error-banner, .notice-banner, .us-apply-banner, .banner) { border-radius: 8px !important; }\n\n/* app chrome: header + navigation rail ---------------------------------- */\n#app .app-header { background: var(--md-surface-container-lowest) !important; border-bottom: 1px solid var(--md-outline-variant) !important; }\n#app .brand-mark, .auth-mark { background: none !important; -webkit-background-clip: border-box !important; background-clip: border-box !important; color: var(--md-on-surface) !important; letter-spacing: normal !important; }\n#app .nav-rail { background: var(--md-surface-container-low) !important; border-right: 1px solid var(--md-outline-variant) !important; gap: 2px !important; }\n#app .nav-rail .nav-item { border-radius: 4px !important; font-weight: 400 !important; }\n#app .nav-rail .nav-item::before { border-radius: 4px !important; width: 56px !important; height: 44px !important; top: 50% !important; left: 50% !important; right: auto !important; bottom: auto !important; transform: translate(-50%, -50%) !important; background: var(--md-secondary-container) !important; }\n#app .nav-rail .nav-item.active::before { transform: translate(-50%, -50%) !important; }\n#app .nav-rail .nav-item.active { color: var(--md-on-surface) !important; font-weight: 600 !important; }\n#app .nav-rail .nav-item.active .nav-icon, #app .nav-rail .nav-item:hover .nav-icon { transform: none !important; }\n#app .nav-rail .nav-item:hover:not(.active)::before { background: var(--md-surface-container-high) !important; }\n#app .sessions { background: var(--md-surface-container-low) !important; border-right: 1px solid var(--md-outline-variant) !important; }\n#app .session-item { border-radius: 4px !important; }\n#app .session-item.selected { background: var(--md-secondary-container) !important; }\n#app .filters button { border-radius: 4px !important; }\n#app .conversation-header { border-bottom: 1px solid var(--md-outline-variant) !important; }\n\n/* settings drawer -------------------------------------------------------- */\n#app .settings-page .settings-nav { background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; border-radius: 8px !important; box-shadow: none !important; padding: 8px !important; gap: 2px !important; }\n#app .settings-page .nav-item::before { display: none !important; }\n#app .settings-page .nav-item { min-height: 40px !important; border-radius: 4px !important; padding: 0 12px !important; gap: 12px !important; font: 400 14px/1.25 var(--font-family) !important; color: var(--md-on-surface) !important; }\n#app .settings-page .nav-item.active { background: var(--md-secondary-container) !important; color: var(--md-on-surface) !important; font-weight: 600 !important; }\n#app .settings-page .nav-item.active .nav-indicator { top: 8px !important; right: auto !important; bottom: 8px !important; left: 0 !important; width: 3px !important; height: auto !important; border-radius: 0 !important; background: var(--md-primary) !important; transform: none !important; opacity: 1 !important; }\n#app .settings-page .nav-item.active .nav-icon { transform: none !important; color: inherit !important; }\n#app .settings-page .nav-item:hover:not(.active) { background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; }\n#app .settings-page .nav-item:hover:not(.active) .nav-indicator { opacity: 0 !important; }\n#app .settings-page .provider-list-item.selected { background: var(--md-secondary-container) !important; border-color: var(--md-outline) !important; }\n\n/* cards: one 8px white layer with a hairline stroke ---------------------- */\n#app :is(.card, .plugin-card, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .content-card, .pp-card, .ls-card, .model-card, .donut-card, .total-card, .host-panel, .character-profile, .pp-stat, .task-item, .lang-card, .pv-card, .pin-card, .stat-ic) { border-radius: 8px !important; background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; box-shadow: none !important; }\n#app .settings-page .content-card { background-image: none !important; }\n#app :is(.content-card, .content-card.danger)::before { display: none !important; }\n#app .pp-stat { padding: 16px 18px !important; color: var(--md-on-surface) !important; }\n#app .pp-stat b { font-size: 28px !important; font-weight: 600 !important; letter-spacing: normal !important; color: var(--md-on-surface) !important; }\n#app .pp-stat span { font-weight: 600 !important; letter-spacing: normal !important; color: var(--md-on-surface-variant) !important; }\n#app .plugins-page .plugin-card { border-radius: 8px !important; padding: 20px !important; }\n#app .plugins-page .plugin-card:hover { transform: none !important; border-color: var(--md-outline) !important; box-shadow: var(--shadow-2) !important; }\n#app .plugins-page .plugin-card.healthy::before { display: none !important; }\n#app .plugin-icon { width: 44px !important; height: 44px !important; border-radius: 4px !important; }\n#app :is(.empty-icon, .stat-ic) { border-radius: 8px !important; }\n#app .usage-page :is(.stat-ic, .mini-ic) { border: none !important; background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; }\n#app :is(.plugin-icon, .empty-icon) { border: none !important; }\n#app .card :is(.card, .content-card, .tasks-card, .settings-card, .stat-card, .memory-card, .plugin-card, .pp-card, .mini, .panel, .host-panel) { border-color: transparent !important; background: var(--md-surface-container-low) !important; }\n\n/* chips and badges: 4px labels, never pills ----------------------------- */\n#app :is(.status-chip, .source-badge, .cap-chip, .badge, .ver-badge, .patch-badge, .pd-chip, .us-chip, .us-chip-tag, .pp-badge, .pp-chip, .chip) { border-radius: 4px !important; height: auto !important; padding: 3px 8px !important; font-size: 12px !important; font-weight: 600 !important; border-color: transparent !important; }\n#app .chip.active { background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; border-color: transparent !important; }\n#app .source-badge.rt { background: var(--md-secondary-container) !important; color: var(--md-on-secondary-container) !important; }\n\n/* buttons: Win11 4px controls, accent fill for actions ------------------- */\n#app button { border-radius: 4px !important; font-weight: 400 !important; letter-spacing: normal !important; }\n#app button:active:not(:disabled) { transform: none !important; }\n#app .btn { height: auto !important; min-height: 34px !important; padding: 6px 16px !important; font-size: 14px !important; font-weight: 400 !important; border-radius: 4px !important; border: 1px solid var(--md-outline) !important; background: var(--md-surface-container-lowest) !important; color: var(--md-on-surface) !important; box-shadow: none !important; transition: background-color 100ms var(--ease-standard), border-color 100ms var(--ease-standard) !important; }\n#app .btn:hover:not(:disabled) { background: var(--md-surface-container-high) !important; transform: none !important; box-shadow: none !important; }\n#app .btn:disabled { opacity: .5 !important; }\n#app :is(.btn-primary, button[type=submit]) { background: var(--md-primary) !important; color: var(--md-on-primary) !important; border-color: transparent !important; }\n#app :is(.btn-primary, button[type=submit]):hover:not(:disabled) { background: var(--brand-hover) !important; }\n#app :is(.btn-tonal, .btn-secondary) { background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; border-color: transparent !important; }\n#app .btn-danger, #app .context-btn.danger { background: transparent !important; color: var(--md-error) !important; border-color: transparent !important; }\n#app .btn-danger:hover:not(:disabled), #app .context-btn.danger:hover:not(:disabled) { background: color-mix(in srgb, var(--md-error) 8%, transparent) !important; }\n#app .btn-ghost { background: transparent !important; border-color: transparent !important; color: var(--md-on-surface) !important; }\n#app .btn-ghost:hover:not(:disabled) { background: var(--md-surface-container-high) !important; }\n#app :is(.icon-btn, .context-btn, .link-btn, .attach-btn, .status-fab) { border-radius: 4px !important; }\n#app :is(.la-btn, .la-btn.la-deny) { border-radius: 4px !important; }\n#app .la-btn.la-allow { background: var(--md-primary) !important; color: var(--md-on-primary) !important; border-color: transparent !important; }\n\n/* fields ----------------------------------------------------------------- */\n#app :is(input.input, textarea.input, .field input, .field textarea, .file-input) { min-height: 34px !important; padding: 7px 11px !important; font-size: 14px !important; border-radius: 4px !important; border: 1px solid var(--md-outline) !important; background: var(--md-surface-container-lowest) !important; }\n#app select:not([multiple]) { min-height: 34px !important; padding: 0 30px 0 10px !important; font-size: 14px !important; border: 1px solid var(--md-outline) !important; border-radius: 4px !important; background-color: var(--md-surface-container-lowest) !important; }\n#app select:not([multiple]):hover { background-color: var(--md-surface-container-high) !important; }\n#app select:not([multiple]):focus { border-color: var(--md-primary) !important; background-color: var(--md-surface-container-lowest) !important; box-shadow: none !important; }\n\n/* combo box -------------------------------------------------------------- */\n#app .app-select-trigger { min-height: 34px !important; border-radius: 4px !important; font-size: 14px !important; font-weight: 400 !important; padding: 0 8px 0 12px !important; gap: 8px !important; background-color: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline) !important; }\n#app .app-select-trigger:hover:not(:disabled) { background-color: var(--md-surface-container-high) !important; }\n#app .app-select-trigger[aria-expanded=\"true\"], #app .app-select-trigger:focus-visible { border-color: var(--md-primary) !important; background-color: var(--md-surface-container-lowest) !important; box-shadow: none !important; }\n.app-select-chevron { width: 20px !important; height: 20px !important; border-radius: 4px !important; }\n#app .app-select-trigger:hover .app-select-chevron { background: transparent !important; }\n.app-select-menu { border-radius: 8px !important; border: 1px solid var(--md-outline-variant) !important; background: var(--md-surface-container-lowest) !important; box-shadow: var(--shadow-4) !important; padding: 4px !important; }\n.app-select-option { border-radius: 4px !important; min-height: 34px !important; font-size: 14px !important; }\n.app-select-option:hover, .app-select-option[aria-selected=\"true\"] { background: var(--md-secondary-container) !important; }\n\n/* toggle switches: 40x20 track, 12px thumb -------------------------------- */\n#app :is(.plugin-switch-slider, .toggle-slider, .switch-track) { width: 40px !important; height: 20px !important; border-width: 1px !important; border-color: var(--md-outline) !important; background: var(--md-surface-container-lowest) !important; }\n#app :is(.plugin-switch-slider, .toggle-slider)::after { content: \"\" !important; width: 12px !important; height: 12px !important; left: 4px !important; top: 50% !important; transform: translateY(-50%) !important; background: var(--md-outline) !important; color: transparent !important; font-size: 0 !important; }\n#app .plugin-switch.on .plugin-switch-slider, #app .toggle-label input:checked + .toggle-slider, #app .switch-track.on { background: var(--md-primary) !important; border-color: var(--md-primary) !important; }\n#app .plugin-switch.on .plugin-switch-slider::after, #app .toggle-label input:checked + .toggle-slider::after { left: 24px !important; width: 12px !important; height: 12px !important; top: 50% !important; transform: translateY(-50%) !important; background: var(--md-on-primary) !important; }\n#app .switch-thumb { width: 12px !important; height: 12px !important; }\n\n/* segmented control (language, filters) ----------------------------------- */\n#app .segmented { padding: 3px !important; gap: 3px !important; background: var(--md-surface-container-high) !important; border: 1px solid var(--md-outline-variant) !important; border-radius: 4px !important; }\n#app .seg { min-height: 32px !important; padding: 0 16px !important; border-radius: 3px !important; font-size: 14px !important; font-weight: 400 !important; }\n#app .seg:hover:not(.active) { background: var(--md-surface-container-highest) !important; }\n#app .seg.active { background: var(--md-primary) !important; color: var(--md-on-primary) !important; box-shadow: none !important; }\n\n/* chat -------------------------------------------------------------------- */\n#app .message.request { background: var(--md-surface-container-high) !important; border: 1px solid var(--md-outline-variant) !important; border-radius: 8px !important; }\n#app .message.response { background: transparent !important; border: 0 !important; border-radius: 0 !important; }\n#app .composer { background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; border-radius: 8px !important; box-shadow: none !important; }\n#app .composer textarea { border-radius: 8px 8px 0 0 !important; }\n#app .composer footer button[type=submit] { border-radius: 4px !important; }\n#app :is(.think-panel, .thinking-popover) { border-radius: 8px !important; border: 1px solid var(--md-outline-variant) !important; }\n\n/* dialogs: one 8px card with a hairline and a deep shadow ------------------ */\n#app :is(.agent-modal, .directory-dialog, .modal-content, .confirm-dialog, .auth-dialog, .pd-dialog, .la-dialog, .inbox-dialog, .mc-consent-dialog, [role=dialog]) { border-radius: 8px !important; border: 1px solid var(--md-outline-variant) !important; box-shadow: var(--shadow-8) !important; }\n:is(.confirm-dialog, .auth-dialog, .pd-dialog, .la-dialog, .inbox-dialog, .mc-consent-dialog) { border-radius: 8px !important; border: 1px solid var(--md-outline-variant) !important; box-shadow: var(--shadow-8) !important; }\n\n/* wizard leftovers ---------------------------------------------------------- */\n#app .step { border-radius: 4px !important; }\n\n/* usage page ---------------------------------------------------------------- */\n#app :is(.mini, .panel) { border-radius: 8px !important; background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; box-shadow: none !important; }\n#app .mini:hover { transform: none !important; box-shadow: var(--shadow-2) !important; }\n#app .mini-ic { border-radius: 4px !important; }\n#app .mini b { font-weight: 600 !important; letter-spacing: normal !important; }\n#app .panel-head h2 { font-weight: 600 !important; letter-spacing: normal !important; }\n#app .model-card::before { display: none !important; }\n\n/* marketplace ---------------------------------------------------------------- */\n#app .mp-title { font-weight: 600 !important; letter-spacing: normal !important; }\n#app .mp-card { border-radius: 8px !important; background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline-variant) !important; }\n#app .mp-card:hover { transform: none !important; border-color: var(--md-outline) !important; box-shadow: var(--shadow-2) !important; }\n#app .mp-btn { min-height: 34px !important; padding: 0 16px !important; border-radius: 4px !important; font-weight: 400 !important; }\n#app .mp-btn:hover:not(:disabled) { transform: none !important; filter: none !important; }\n#app .mp-btn:not(.tonal):not(.install):not(.danger) { background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; }\n#app .mp-btn:not(.tonal):not(.install):not(.danger):hover:not(:disabled) { background: var(--md-surface-container-highest) !important; }\n#app .mp-btn.tonal { background: var(--md-surface-container-high) !important; color: var(--md-on-surface) !important; }\n#app .mp-btn.tonal:hover:not(:disabled) { background: var(--md-surface-container-highest) !important; }\n#app .mp-btn.install { background: var(--md-primary) !important; color: var(--md-on-primary) !important; }\n#app .mp-btn.install:hover:not(:disabled) { background: var(--brand-hover) !important; }\n#app .mp-btn.danger { background: transparent !important; color: var(--md-error) !important; }\n#app .mp-btn.danger:hover:not(:disabled) { background: color-mix(in srgb, var(--md-error) 8%, transparent) !important; }\n#app .mp-installed { color: var(--md-on-surface-variant) !important; font-weight: 400 !important; }\n#app .mp-chip { border-radius: 4px !important; font-size: 12px !important; font-weight: 600 !important; padding: 3px 8px !important; }\n#app .mp-search { min-height: 34px !important; padding: 0 11px !important; border-radius: 4px !important; background: var(--md-surface-container-lowest) !important; border: 1px solid var(--md-outline) !important; }\n#app .mp-search:focus { box-shadow: none !important; }\n#app .mp-stars { border-radius: 4px !important; font-weight: 600 !important; padding: 3px 8px !important; background: var(--md-surface-container-high) !important; color: var(--md-on-surface-variant) !important; }\n#app .mp-avatar { border-radius: 4px !important; }\n\n/* Fluent glyph icons --------------------------------------------------------\n   Win11 draws its chrome with the Segoe Fluent Icons font, not line-art svg.\n   The host svgs are hidden and a font glyph takes their place (Segoe MDL2\n   Assets covers older Windows; both fonts are local, no network dependency).\n   The rail maps each item by its href; the settings tabs are <button>s with\n   no attribute to key on, so they use the rendered tab order (BUILTIN_SETTINGS\n   + patch tabs: general, appearance, provider, persona, live2d, permissions,\n   life, danger, updates, about, models, agent) - if new settings plugins add\n   tabs ahead of these, the trailing glyph indices shift. */\n#app .nav-rail .nav-icon, #app .settings-page .nav-icon, #app .settings-btn, #app .send-button, #app .attach-btn, #app .usage-page .stat-ic, #app .usage-page .mini-ic, #app .plugin-icon, #app .empty-icon { font-family: \"Segoe Fluent Icons\", \"Segoe MDL2 Assets\", \"Segoe UI Symbol\", sans-serif !important; font-weight: 400 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; }\n#app .nav-rail a.nav-item .nav-icon svg, #app .settings-page .nav-icon svg, #app .settings-btn svg, #app .send-button svg, #app .attach-btn svg, #app .usage-page .stat-ic svg, #app .usage-page .mini-ic svg, #app .plugin-icon svg, #app .empty-icon svg { display: none !important; }\n\n#app .nav-rail .nav-icon::before, #app .settings-page .nav-icon::before, #app .settings-btn::before, #app .send-button::before, #app .attach-btn::before, #app .usage-page .stat-ic::before, #app .usage-page .mini-ic::before, #app .plugin-icon::before, #app .empty-icon::before { line-height: 1 !important; }\n\n/* nav rail: one glyph per destination */\n#app .nav-rail a[href=\"/\"] .nav-icon::before { content: \"E8BD\"; font-size: 20px; }\n#app .nav-rail a[href=\"/agents\"] .nav-icon::before { content: \"E99A\"; font-size: 20px; }\n#app .nav-rail a[href=\"/memory\"] .nav-icon::before { content: \"E7B8\"; font-size: 20px; }\n#app .nav-rail a[href=\"/companion\"] .nav-icon::before { content: \"E716\"; font-size: 20px; }\n#app .nav-rail a[href=\"/skills\"] .nav-icon::before { content: \"E945\"; font-size: 20px; }\n#app .nav-rail a[href=\"/plugins\"] .nav-icon::before { content: \"E8A9\"; font-size: 20px; }\n#app .nav-rail a[href=\"/marketplace\"] .nav-icon::before { content: \"E719\"; font-size: 20px; }\n#app .nav-rail a[href=\"/usage\"] .nav-icon::before { content: \"E9D9\"; font-size: 20px; }\n#app .nav-rail a[href=\"/settings\"] .nav-icon::before { content: \"E713\"; font-size: 20px; }\n\n/* settings tabs, by rendered position (see note above) */\n#app .settings-page .settings-nav .nav-item:nth-child(1) .nav-icon::before { content: \"E774\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(2) .nav-icon::before { content: \"E706\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(3) .nav-icon::before { content: \"E83C\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(4) .nav-icon::before { content: \"E77B\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(5) .nav-icon::before { content: \"E76E\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(6) .nav-icon::before { content: \"E730\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(7) .nav-icon::before { content: \"E72E\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(8) .nav-icon::before { content: \"E7BA\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(9) .nav-icon::before { content: \"E896\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(10) .nav-icon::before { content: \"E946\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(11) .nav-icon::before { content: \"E964\"; font-size: 18px; }\n#app .settings-page .settings-nav .nav-item:nth-child(12) .nav-icon::before { content: \"E99A\"; font-size: 18px; }\n\n/* header + composer */\n#app .settings-btn::before { content: \"E713\"; font-size: 20px; }\n#app .send-button::before { content: \"E724\"; font-size: 18px; }\n#app .attach-btn:has(> svg > rect)::before { content: \"E91B\"; font-size: 16px; }\n#app .attach-btn:not(:has(> svg > rect))::before { content: \"E723\"; font-size: 16px; }\n\n/* tiles + empty state */\n#app .usage-page .stat-ic::before { content: \"E943\"; font-size: 20px; }\n#app .usage-page .mini-ic::before { content: \"E8A5\"; font-size: 16px; }\n#app .plugin-icon::before { content: \"E8A9\"; font-size: 20px; }\n#app .empty-icon::before { content: \"E90A\"; font-size: 24px; }\n\n/* Fluent focus rectangle ---------------------------------------------------- */\n#app :is(button, a, input, select, textarea, summary, [tabindex]):focus-visible { outline: 2px solid var(--md-primary) !important; outline-offset: 1px !important; box-shadow: none !important; }\n\n/* scrollbars: thin Fluent bars ------------------------------------------------ */\n*::-webkit-scrollbar { width: 12px !important; height: 12px !important; }\n*::-webkit-scrollbar-thumb { background: var(--md-outline) !important; border: 3px solid transparent !important; background-clip: padding-box !important; border-radius: 999px !important; }\n*::-webkit-scrollbar-track { background: transparent !important; }\n\n/* ---------- Fluent motion ----------------------------------------------------\n   Win11 motion is short and never overshoots: ~100ms for state changes,\n   ~150-200ms for control movement, and entrances are a quick decelerating\n   fade with a small settle. The host ships M3 Expressive springs\n   (cubic-bezier(.22,1.3,.36,1)) and 300-700ms entrances; retune the vars,\n   re-drive entrances on our own keyframes (order-independent, unlike\n   redefining the host's) and flatten every hover lift. */\n\n/* these vars are redefined locally on page roots, so an inherited token loses;\n   override them at the redefinition site */\n#app .settings-page { --set-spring: cubic-bezier(.8, 0, .2, 1) !important; --set-emph: cubic-bezier(.8, 0, .2, 1) !important; --set-decel: cubic-bezier(.1, .9, .2, 1) !important; }\n#app .life-settings { --ls-spring: cubic-bezier(.8, 0, .2, 1) !important; }\n\n@keyframes fluent-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n\n/* entrances: 200ms fade + 8px settle (host: 320-700ms with springs) */\n#app :is(.page-header, .content-card, .card, .plugin-card, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .mini, .panel, .model-card, .pp-stat, .ls-hero, .ls-card, .ls-state, .turn, .host-panel, .empty-icon) { animation: fluent-rise 200ms cubic-bezier(.1, .9, .2, 1) both !important; }\n\n/* dialogs: 180ms fade-up, no scale bounce */\n#app :is(.confirm-dialog, .pd-dialog, .la-dialog, .inbox-dialog, .agent-modal, .modal-content, .directory-dialog, [role=dialog]) { animation: fluent-rise 180ms cubic-bezier(.1, .9, .2, 1) both !important; }\n\n/* controls keep the host's transition properties, retime them to standard;\n   moving parts (thumb, indicator) run at 150ms with no spring */\n#app :is(.seg, .segmented, .chip, .nav-item, .session-item, .filters button, .plugin-switch-slider, .toggle-slider, .switch-track, .switch-thumb, .app-select-trigger, .app-select-menu, .app-select-option, .app-select-chevron, .app-select-menu-enter-active, .app-select-menu-leave-active, .mp-card, .plugin-card, .content-card, .card, .mini, .panel, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .settings-nav, .nav-indicator) { transition-duration: 150ms !important; transition-timing-function: var(--ease-standard) !important; }\n#app :is(.plugin-switch-slider, .toggle-slider, .switch-track, .nav-item)::after { transition-duration: 150ms !important; transition-timing-function: var(--ease-standard) !important; }\n\n/* buttons: state change only — no lift, no brightness filter, no press scale */\n#app button { transition: background-color 100ms var(--ease-standard), border-color 100ms var(--ease-standard), color 100ms var(--ease-standard), box-shadow 150ms var(--ease-standard), transform 100ms var(--ease-standard) !important; }\n#app button:hover:not(:disabled) { transform: none !important; filter: none !important; }\n#app :is(.card, .content-card, .stat-card, .memory-card, .provider-card, .settings-card, .tasks-card, .plugin-card, .pp-card, .ls-card, .model-card, .donut-card, .total-card, .us-card, .mini, .panel, .mp-card, .pp-stat, .task-item):hover { transform: none !important; }\n\n/* darkmode's 560ms full-page crossfade + radial wash: 150ms crossfade, no wash */\n:root.0kay-theme-fade, :root.0kay-theme-fade *, :root.0kay-theme-fade *::before, :root.0kay-theme-fade *::after { transition-duration: 150ms !important; }\n#0kay-theme-wipe { display: none !important; }\n"
