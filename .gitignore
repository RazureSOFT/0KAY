life/life-review-report-v2-addendum.md
life/life-review-report-v2.md
life/life-review-report.md
# Local review reports (root level only; a repo-wide *REVIEW* glob would
# silently swallow any file whose name happens to contain it).
/REVIEW*.md
/*REVIEW*.md

# Compiled devkit java classes (devkit/build.sh regenerates them).
/devkit/java/out/

# Provider-specific backend plugins. They stay local on purpose: soniox-asr/
# carries reverse-engineered endpoint/websocket details and genie-tts/ vendors
# an ONNX voice stack, neither of which belongs in a public Core repository.
# Core only depends on the endpoint contract (docs/asr.md, docs/tts.md).
/soniox-asr/
/genie-tts/

# Local research/usage notes about the Genie backend, kept out of the repo the
# same way genie-tts/ itself is.
/Genie-TTS-分析报告.md
/Genie合成器-使用说明.txt

# Soniox reverse-engineering notes (endpoint analysis, transcribe results), kept
# local like soniox-asr/ itself.
/soniox-china-endpoints-analysis.md
/soniox-live-transcribe-guide.md
/soniox-transcribe-result.md
/soniox-transcribe-victory.md

# Scratch and internal work notes that had been committed by accident.
/e.g/
/life/life-backlog.md
/life/life-toward-a-person.md
/life/life-wiring-and-capability-audit.md
/life/life-wiring-fixes-implemented.md

# Local Genie helpers (genie_gui.py is launched by the desktop shortcut). They
# talk to this machine's D:\Genie checkout, so they stay out of the repo.
/genie_*.py

# Prebuilt UI bundle of the local-only deepseek-web plugin (its own repository:
# razureink/0KAY-deepseek-web). Core loads it from disk when the plugin runs.
/core/data/plugin-ui/deepseek-web/

# Self-iteration worktrees created by the agent.
/.evolve/

# One-off execution plans written for the user (kept local on purpose).
/plans/

# Local working agreement for whoever (or whatever) edits this checkout.
/LOCAL-RULES.md
.0kay-agent/

# Runtime session logs written by Core.
/core/data/sessions/

# Reference checkout kept for reading, not part of this repository.
/tui/Claude-Code-rev/

# Electron build output.
/desktop/release/
/desktop/dist-electron/
# Stack copied into the desktop app by packaging/build.py before electron-builder.
/desktop/resources-stack/
# Packaging intermediates and output.
/build/
/dist/
/dist-local/

# The IDE fork keeps its own git history (like agent/).
/0kay-ide/

# Machine credential shared by Core and 0KAY IDE.
/.run/api-token

# The VSCodium-based editor is its own repo, like agent/ and 0kay-ide/.
/0kay-code/

# Core mints its own device token on first start; it is a credential.
/core/data/device-token

# Plugin UI pages are build output, not source.
#
# These twelve files are what `npm run build:plugin` (webui) and each
# plugin-web/*/build produce. They were tracked, which meant every frontend
# change added a diff nobody can review — the agent page alone is 82k lines on
# one line — and CI had to diff the bundle to notice it was stale.
#
# They are built during install and in CI instead. The source lives in webui/src
# and plugin-web/*/src.
#
# Not everything in this directory is generated: darkmode/, compat/ and
# marketplace/ ship hand-written JavaScript that is loaded as-is, so those stay
# tracked. Ignoring "*.js" wholesale would have deleted real code.
/core/data/plugin-ui/agent/index.js
# The platform pages ship one self-contained file each, plus the string
# resources the build copies next to them. Both are build output.
/core/data/plugin-ui/webui/
/core/data/plugin-ui/webui/chat.js
/core/data/plugin-ui/webui/settings.js
/core/data/plugin-ui/webui/plugins.js
/core/data/plugin-ui/webui/console.js
/core/data/plugin-ui/webui/usage.js
/core/data/plugin-ui/life/companion.js
/core/data/plugin-ui/life/memory.js
/core/data/plugin-ui/life/social.js
/core/data/plugin-ui/life/adapters.js
/core/data/plugin-ui/minecraft/index.js
/core/data/plugin-ui/skillsguishow/index.js

# Installed agent extensions are user data: what an operator installed, not
# what the repository ships. The bundled examples live in agent/plugins/.
/core/data/extensions/

# Generated by plugin-web/agent/scripts/verify-empty-layout.mjs
plugin-web/agent/scripts/.empty-state-fixture.html
plugin-web/agent/scripts/.empty-state.png
