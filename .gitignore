# Local buf binary
buf.exe

# Agent remains an independent repository.
/agent/
# 0kay-pm remains an independent repository.
/pm/
# 0kay-mcp (MCP client gateway + shared protobufs) remains an independent repository.
/mcp/
# 0kay-minecraft (Minecraft bot plugin) remains an independent repository.
/minecraft/
# 0kay-free-model remains an independent repository.
/free-model/
# 0kay-deepseek-web remains an independent repository (razureink/0KAY-deepseek-web).
/deepseek-web/
# 0kay-deepseek-tts remains an independent repository (razureink/0KAY-deepseek-tts).
/deepseek-tts/
node_modules
core/data/tasks.json
core/data/tasks.json.journal
core/data/task_callbacks.json
core/data/paired_devices.json
core/data/core.crt
core/data/core.key
**/runtime-env.json
# Local runtime secrets (generated registration/service tokens); never commit.
/.env
/.env.*

# Local tooling & runtime artifacts
buf-win.exe
/_site/
/data/
core/data/updates/
# FluentUI is a patch-only plugin installed by 0kay-pm into core/data/ui; the
# built-in patches are tracked, this one is a runtime artifact.
core/data/ui/fluentui.patch
webui/scripts/shots/
webui/scripts/skills-ui.png

# Live2D models are large binary assets; they are not tracked or pushed.
webui/public/live2d/models/

# Generated research artifacts (figures, papers, scratch notes).
life/output/

# Local experiment scratch and model checkpoints (regenerable, not source).
life/working/
life/models/

# Tool-internal memory, not project content.
.workbuddy-ai/

# ZCode is an independent workspace (its own .gitignore, pnpm workspace and
# env files); it must not be absorbed into this repository.
/ZCode/

# Local build backups.
*.exe.bak
*.exe.orig

# Local runtime artifacts (never commit these).
life/run.pid
core/data/*.bak-*

# Plugin UI bundles are regenerated by Core on startup; the tracked copies are
# refreshed deliberately, but the exploded `assets/` sub-tree is pure build
# output (b6bf246 removed the ones that had been committed by mistake).
core/data/plugin-ui/**/assets/

# Local runtime state from start-0kay.sh: logs, pid files, compiled binaries in
# .run/, and the agent's own scratch notes. Never source.
/.logs/
/.run/
/.0kay.pids
/.0kay-agent/
/.codebuddy/

# Build output of the devkit's Rust crate.
/devkit/rust/target/

# Python bytecode.
__pycache__/
*.pyc

# Review/analysis reports — intentionally excluded from the repo so they are
# never committed or pushed to the remote again. (Removed from main on
# 2026-10-11; the remote had already removed several of these.)
CODE_REVIEW-2026-10-07.md
FULL_REVIEW-2026-10-05.md
UI_LAYOUT_REVIEW-2026-10-06.md
UI_LAYOUT_FIXES-2026-10-06.md
life/life-review-fixes.md
life/life-review-report-v2-addendum.md
life/life-review-report-v2.md
life/life-review-report.md
*REVIEW*.md

# Compiled devkit java classes (devkit/build.sh regenerates them).
/devkit/java/out/

# Provider-specific backend plugins. They stay local on purpose: soniox-asr/
# carries reverse-engineered endpoint/websocket details and genie-tts/ vendors
# an ONNX voice stack, neither of which belongs in a public Core repository.
# Core only depends on the endpoint contract (docs/asr.md, docs/tts.md).
/soniox-asr/
/genie-tts/

# Local research/usage notes about the Genie backend, kept out of the repo the
# same way genie-tts/ itself is.
/Genie-TTS-分析报告.md
/Genie合成器-使用说明.txt

# Soniox reverse-engineering notes (endpoint analysis, transcribe results), kept
# local like soniox-asr/ itself.
/soniox-china-endpoints-analysis.md
/soniox-live-transcribe-guide.md
/soniox-transcribe-result.md
/soniox-transcribe-victory.md

# Scratch and internal work notes that had been committed by accident.
/e.g/
/life/life-backlog.md
/life/life-toward-a-person.md
/life/life-wiring-and-capability-audit.md
/life/life-wiring-fixes-implemented.md

# Local Genie helpers (genie_gui.py is launched by the desktop shortcut). They
# talk to this machine's D:\Genie checkout, so they stay out of the repo.
/genie_*.py

# Prebuilt UI bundle of the local-only deepseek-web plugin (its own repository:
# razureink/0KAY-deepseek-web). Core loads it from disk when the plugin runs.
/core/data/plugin-ui/deepseek-web/

# Self-iteration worktrees created by the agent.
/.evolve/
