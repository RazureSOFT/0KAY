# Local buf binary
buf.exe

# Agent remains an independent repository.
/agent/
# 0kay-pm remains an independent repository.
/pm/
# 0kay-mcp (MCP client gateway + shared protobufs) remains an independent repository.
/mcp/
# 0kay-minecraft (Minecraft bot plugin) remains an independent repository.
/minecraft/
# 0kay-free-model remains an independent repository.
/free-model/
# 0kay-deepseek-web remains an independent repository (razureink/0KAY-deepseek-web).
/deepseek-web/
# 0kay-deepseek-tts remains an independent repository (razureink/0KAY-deepseek-tts).
/deepseek-tts/
node_modules
core/data/tasks.json
core/data/tasks.json.journal
core/data/task_callbacks.json
core/data/paired_devices.json
core/data/core.crt
core/data/core.key
**/runtime-env.json
# Local runtime secrets (generated registration/service tokens); never commit.
/.env
/.env.*

# Local tooling & runtime artifacts
buf-win.exe
/_site/
/data/
core/data/updates/
# FluentUI is a patch-only plugin installed by 0kay-pm into core/data/ui; the
# built-in patches are tracked, this one is a runtime artifact.
core/data/ui/fluentui.patch
webui/scripts/shots/
webui/scripts/skills-ui.png

# Live2D models are large binary assets; they are not tracked or pushed.
webui/public/live2d/models/

# Generated research artifacts (figures, papers, scratch notes).
life/output/

# Local experiment scratch and model checkpoints (regenerable, not source).
life/working/
life/models/

# Tool-internal memory, not project content.
.workbuddy-ai/

# ZCode is an independent workspace (its own .gitignore, pnpm workspace and
# env files); it must not be absorbed into this repository.
/ZCode/

# Local build backups.
*.exe.bak
*.exe.orig

# Local runtime artifacts (never commit these).
life/run.pid
core/data/*.bak-*

# Plugin UI bundles are regenerated by Core on startup; the tracked copies are
# refreshed deliberately, but the exploded `assets/` sub-tree is pure build
# output (b6bf246 removed the ones that had been committed by mistake).
core/data/plugin-ui/**/assets/
