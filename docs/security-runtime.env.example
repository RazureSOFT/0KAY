# Generate independent random values. Never commit a populated copy.
# Compose reads a .env in D:\0kay (or pass --env-file explicitly).
CORE_API_TOKEN=
CORE_PLUGIN_REGISTRATION_TOKEN=
LIFE_REGISTRATION_TOKEN=
AGENT_REGISTRATION_TOKEN=
MOCR_REGISTRATION_TOKEN=
MOCR_GRPC_TOKEN=
TTS_SERVICE_TOKEN=
MINECRAFT_TOKEN=
DEEPSEEK_WEB_SERVICE_TOKEN=

# Native installations: Core receives per-name values below. Each plugin
# receives ONLY its own enrollment value as CORE_PLUGIN_REGISTRATION_TOKEN.
# CORE_PLUGIN_TOKEN_LIFE=<LIFE_REGISTRATION_TOKEN>
# CORE_PLUGIN_TOKEN_AGENT=<AGENT_REGISTRATION_TOKEN>
# CORE_PLUGIN_TOKEN_MOCR=<MOCR_REGISTRATION_TOKEN>
# CORE_PLUGIN_TOKEN_MINECRAFT=<independent minecraft enrollment secret>
# TTS and Minecraft callers receive the matching SERVICE_TOKEN / TOKEN.
# For native LIFE using local TTS explicitly set LIFE_ALLOW_PRIVATE_TTS=1.
